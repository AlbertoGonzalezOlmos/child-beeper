<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#8BC7FF</item>
        <item name="android:windowBackground">#101820</item>
        <item name="android:colorButtonNormal">#263E52</item>
        <item name="android:statusBarColor">#101820</item>
        <item name="android:navigationBarColor">#101820</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#8BC7FF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
